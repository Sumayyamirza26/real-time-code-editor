# dependencies
node_modules/
**/node_modules/

# env
.env
.env.*
backend/.env
frontend/.env

# production
build/
frontend/build/

# runtime data & temp (local only, auto-created at boot)
.data/
temp/

# backend execution leftovers (scoped to backend/ only —
# bare patterns like test*/file.*/*.cpp would also match real source
# such as backend/models/File.js and backend/docker/Dockerfile.cpp)
backend/test
backend/test.*
backend/test_*.js
backend/file.*
backend/output

# never ignore these real source files
!backend/models/File.js
!backend/docker/Dockerfile.cpp

# misc
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
